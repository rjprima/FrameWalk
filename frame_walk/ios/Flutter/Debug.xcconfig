#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Team defaults for the iOS bundle ID and signing team. To build with your own
// Apple team, override these in Secrets.xcconfig (included below, so it wins).
FRAMEWALK_BUNDLE_ID = com.jltrinh.frameWalk
FRAMEWALK_DEVELOPMENT_TEAM = 3WQ2H2UFVZ

// Each developer's own Google Maps API key and optional bundle ID/team overrides
// (not committed). See README "iOS Setup".
#include? "Secrets.xcconfig"
